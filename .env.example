# Copy this file to .env and fill in the values. .env is gitignored.

# https://serpapi.com/  -> Dashboard -> Your Private API Key
# Free tier: ~100 searches/month. Do not burn these in retry loops.
SERPAPI_KEY=

# https://api.imgbb.com/  -> Get API key (free, no card)
IMGBB_KEY=

# Cosine similarity above which two faces are considered the same person.
# DO NOT trust this default - day1_calibrate.py exists to derive it from real data.
MATCH_THRESHOLD=0.60

# --- Day 2: Base Sepolia (not needed today) ---
BASE_SEPOLIA_RPC=https://sepolia.base.org
DEPLOYER_PRIVATE_KEY=
CONTRACT_ADDRESS=
